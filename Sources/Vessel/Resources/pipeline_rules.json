{
  "version": 1,
  "about": "Which decoder each satellite uses. First matching rule wins. Each rule lists decoders in order of preference, and the first that can run live is used. If only non-live ones exist, the satellite is saved to file instead. Matches are case-insensitive regular expressions on the satellite's catalogue name. frequencyMHz overrides the decoder's own frequency.",
  "rules": [
    { "match": "^METEOR-M2 [34]\\b", "pipelines": ["meteor_m2-x_lrpt", "meteor_m2-x_lrpt_80k", "meteor_hrpt"], "frequencyMHz": 137.9 },
    { "match": "^METEOR-M(2 2| 2)\\b", "pipelines": ["meteor_hrpt", "meteor_m2_lrpt"] },
    { "match": "^METOP-SG", "pipelines": ["metopsg_ddb"] },
    { "match": "^METOP-[ABC]\\b", "pipelines": ["metop_ahrpt", "metop_dump"] },

    { "match": "^NOAA[- ]15\\b", "pipelines": ["noaa_apt", "noaa_hrpt"], "frequencyMHz": 137.62 },
    { "match": "^NOAA[- ]18\\b", "pipelines": ["noaa_apt", "noaa_hrpt"], "frequencyMHz": 137.9125 },
    { "match": "^NOAA[- ]19\\b", "pipelines": ["noaa_apt", "noaa_hrpt"], "frequencyMHz": 137.1 },
    { "match": "^NOAA[- ]20\\b", "pipelines": ["npp_hrd"] },
    { "match": "^NOAA[- ]21\\b", "pipelines": ["jpss_tlm", "jpss_hrd"] },
    { "match": "^SUOMI NPP\\b", "pipelines": ["npp_hrd"] },

    { "match": "^GOES[- ](16|17|18|19)\\b", "pipelines": ["goes_hrit", "goes_grb"] },
    { "match": "^GOES[- ](13|14|15)\\b", "pipelines": ["goes_lrit", "goes_gvar"] },

    { "match": "^(FENGYUN|FY-?)[ -]?3[AB]\\b", "pipelines": ["fengyun3_ab_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3C\\b", "pipelines": ["fengyun3_c_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3D\\b", "pipelines": ["fengyun3_d_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3E\\b", "pipelines": ["fengyun3_e_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3F\\b", "pipelines": ["fengyun3_f_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3G\\b", "pipelines": ["fengyun3_g_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?3H\\b", "pipelines": ["fengyun3_h_ahrpt"] },
    { "match": "^(FENGYUN|FY-?)[ -]?2", "pipelines": ["fengyun_svissr"] },
    { "match": "^(FENGYUN|FY-?)[ -]?4A\\b", "pipelines": ["fengyun4_a_lrit", "fengyun4_a_hrit23"] },
    { "match": "^(FENGYUN|FY-?)[ -]?4B\\b", "pipelines": ["fengyun4_b_lrit"] },

    { "match": "^HIMAWARI", "pipelines": ["himawaricast"] },
    { "match": "^(GEO-?KOMPSAT-?2A|GK-?2A)\\b", "pipelines": ["gk2a_lrit", "gk2a_hrit"] },
    { "match": "^METEOSAT-(8|9|10|11)\\b", "pipelines": ["msg_raw"] },
    { "match": "^METEOSAT-1[2-9]\\b", "pipelines": ["mtg_raw", "mtg_s_band_link"] },
    { "match": "^ELEKTRO-L", "pipelines": ["elektro_lrit", "elektro_hrit", "elektro_ggak"] },
    { "match": "^ARKTIKA-M 1\\b", "pipelines": ["arktika_m1_ggak"] },
    { "match": "^ARKTIKA-M 2\\b", "pipelines": ["arktika_m2_ggak"] },
    { "match": "^INSAT-3D", "pipelines": ["insat_3d_imager"] },

    { "match": "^TERRA$", "pipelines": ["terra_db"] },
    { "match": "^AQUA$", "pipelines": ["aqua_db"] },
    { "match": "^AURA$", "pipelines": ["aura_db"] },
    { "match": "^DMSP\\b", "pipelines": ["dmsp_rtd"] },
    { "match": "^WSF-M\\b", "pipelines": ["wsf_m_db"] },
    { "match": "^SMAP$", "pipelines": ["smap_s_link"] },
    { "match": "^SARAL$", "pipelines": ["saral_l_band", "saral_dump"] },
    { "match": "^JASON-3\\b", "pipelines": ["jason3_link"] },
    { "match": "^SENTINEL-6", "pipelines": ["sentinel6_tlm", "sentinel6_dump"] },
    { "match": "^LANDSAT (8|9)\\b", "pipelines": ["landsat_ldcm_tlm", "landsat_ldcm_link"] },
    { "match": "^PROBA-1\\b", "pipelines": ["proba1_dump"] },
    { "match": "^PROBA-2\\b", "pipelines": ["proba2_dump"] },
    { "match": "^PROBA-V\\b", "pipelines": ["probav_s_dump", "probav_x_dump"] },
    { "match": "^PROBA-3\\b", "pipelines": ["proba3_dump_pm", "proba3_dump_qpsk"] },
    { "match": "^CRYOSAT", "pipelines": ["cryosat_dump"] },
    { "match": "^KANOPUS-V", "pipelines": ["kanopus_v_qpsk"] },
    { "match": "^MATS$", "pipelines": ["mats_dump"] },
    { "match": "^GPM-CORE\\b", "pipelines": ["gpm_core_dump"] },
    { "match": "^GCOM-W", "pipelines": ["gcom_w1_link"] },
    { "match": "^GCOM-C", "pipelines": ["gcom_c1_link"] },
    { "match": "^HINODE\\b", "pipelines": ["hinode_s_tlm", "hinode_s_dump"] },
    { "match": "^FORMOSAT-5\\b", "pipelines": ["formosat5_s_dump"] },
    { "match": "^FORMOSAT[- ]7", "pipelines": ["formosat7_s_dump"] },
    { "match": "^OCEANSAT-2\\b", "pipelines": ["oceansat2_db"] },
    { "match": "^OCEANSAT-3\\b", "pipelines": ["oceansat3_argos", "oceansat3_dump"] },
    { "match": "^SAOCOM 1[AB]\\b", "pipelines": ["saocom_1ab_tlm_dump"] },
    { "match": "^PREFIRE-[12]\\b", "pipelines": ["prefire_s_dump"] },
    { "match": "^ORBCOMM\\b", "pipelines": ["orbcomm_stx_auto", "orbcomm_stx"] },
    { "match": "^INMARSAT\\b", "pipelines": ["inmarsat_std_c"] },
    { "match": "^COSMOS 2558\\b", "pipelines": ["cosmos_2558_dump"] },
    { "match": "^BLUEWALKER", "pipelines": ["bluewalker3_narrow", "bluewalker3_wide"] },
    { "match": "^DSCOVR\\b", "pipelines": ["dscovr_tlm"] },
    { "match": "^STEREO", "pipelines": ["stereo_lr"] },
    { "match": "^TROPICS", "pipelines": ["tropics_link"] },
    { "match": "^VIASAT-3", "pipelines": ["viasat3_tlm"] },
    { "match": "^SYRACUSE 3", "pipelines": ["syracuse3_tlm"] },
    { "match": "^TUBIN\\b", "pipelines": ["tubin_x_dump"] }
  ]
}
